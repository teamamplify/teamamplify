# Claude API (required for opportunity evaluation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email delivery — SendGrid (primary)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=team@amplifyimpact.agency
TO_EMAIL=whitney@amplifyimpact.today

# Email delivery — SMTP (fallback if SendGrid unavailable)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# Optional overrides
ARIA_LOOKBACK_DAYS=30         # How many days back to search (default 30)
ARIA_HISTORY_FILE=aria/data/run_history.json
